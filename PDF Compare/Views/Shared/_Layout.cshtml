<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PDF_Compare</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --nav-bg: #ffffff;
                --nav-border: #e2e8f0;
                --primary-accent: #2563eb;
                --text-dark: #0f172a;
                --text-muted: #64748b;
            }

            html, body {
                height: 100%;
            }

            body {
                display: flex;
                flex-direction: column;
                background-color: #f8fafc;
                color: var(--text-dark);
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            /* Modern Navbar Styling */
            .custom-navbar {
                background: rgba(255, 255, 255, 0.95) !important;
                backdrop-filter: blur(8px);
                border-bottom: 1px solid var(--nav-border);
                box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.02);
                padding-top: 0.75rem;
                padding-bottom: 0.75rem;
            }

            .navbar-brand-custom {
                font-weight: 700;
                font-size: 1.15rem;
                color: #0f172a !important;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                letter-spacing: -0.02em;
                text-decoration: none;
            }

            .brand-icon {
                width: 32px;
                height: 32px;
                background: linear-gradient(135deg, #2563eb, #1d4ed8);
                color: white;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1rem;
                box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
            }

            .nav-link-custom {
                font-weight: 600;
                font-size: 0.92rem;
                color: var(--text-muted) !important;
                padding: 0.5rem 0.9rem !important;
                border-radius: 8px;
                transition: all 0.15s ease-in-out;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
            }

            .nav-link-custom:hover {
                color: var(--primary-accent) !important;
                background-color: #eff6ff;
            }

            /* Content Area wrapper */
            .main-wrapper {
                flex: 1 0 auto;
            }

            /* Modern Footer */
            .custom-footer {
                background-color: #ffffff;
                border-top: 1px solid var(--nav-border);
                color: var(--text-muted);
                font-size: 0.88rem;
                padding: 1.25rem 0;
                flex-shrink: 0;
            }

            .footer-link {
                color: var(--text-muted);
                text-decoration: none;
                transition: color 0.15s ease;
            }

            .footer-link:hover {
                color: var(--primary-accent);
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light custom-navbar mb-3">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom" asp-area="" asp-controller="Comparison" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-file-earmark-diff"></i></span>
                    <span>PDF<span class="text-primary">Compare</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0 ms-sm-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-area="" asp-controller="Comparison" asp-action="History">
                                <i class="bi bi-clock-history"></i> History
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> AI Powered
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year - <strong>PDF_Compare</strong></span>
                <span class="text-black-50">|</span>
                <span class="text-muted small">Medicare EOC Differential Engine</span>
            </div>
            <div>
                <a class="footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>